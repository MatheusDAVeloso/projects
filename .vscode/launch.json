{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // ——————————————————————————————————————————————————
        // FLUTTER
        // ——————————————————————————————————————————————————
        {
            "name": "Flutter — Profile Mode",
            "type": "dart",
            "cwd": "information_technology/flutter/flutter_application",
            "request": "launch",
            "flutterMode": "profile"
        },
        {
            "name": "Flutter — Debug Mode",
            "type": "dart",
            "cwd": "information_technology/flutter/flutter_application",
            "request": "launch",
            "flutterMode": "debug"
        },
        {
            "name": "Flutter — Release Mode",
            "type": "dart",
            "cwd": "information_technology/flutter/flutter_application",
            "request": "launch",
            "flutterMode": "release"
        },
        // ——————————————————————————————————————————————————
        // TypeScript
        // ——————————————————————————————————————————————————
        {
            "name": "TS — Random Walker",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "tsc: watch - studies/information_technology/typescript/tsconfig.json",
            "program": "${workspaceFolder}/studies/information_technology/typescript/dist/index.js",
            "skipFiles": [
                "<node_internals/**>"
            ],
            "outFiles": [
                "${workspaceFolder}/**/*.js",
            ]
        }
    ]
}